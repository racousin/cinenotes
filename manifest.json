{
  "manifest_version": 3,
  "name": "CinéNotes – Ratings for Netflix",
  "short_name": "CinéNotes",
  "version": "1.0.0",
  "description": "Notes AlloCiné (presse & spectateurs), IMDb, Rotten Tomatoes et Metacritic directement sur Netflix. Non affilié à Netflix.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.allocine.fr/*",
    "https://www.rottentomatoes.com/*",
    "https://v3.sg.media-imdb.com/*",
    "https://www.omdbapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js",
        "ranking.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "netflix-meta.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "CinéNotes",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
